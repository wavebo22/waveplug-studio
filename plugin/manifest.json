{
  "manifestVersion": 5,
  "id": "com.waveplug.studio",
  "name": "WavePlug Studio",
  "version": "1.3.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "studio",
      "label": {
        "default": "WavePlug Studio"
      },
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 800,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 760
      }
    },
    {
      "type": "panel",
      "id": "layers",
      "label": {
        "default": "WavePlug 图层"
      },
      "minimumSize": {
        "width": 220,
        "height": 200
      },
      "maximumSize": {
        "width": 800,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 600
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "file"
      ],
      "extensions": [
        ".bat",
        ".cmd",
        ".exe"
      ]
    },
    "allowCodeGenerationFromStrings": true
  }
}
