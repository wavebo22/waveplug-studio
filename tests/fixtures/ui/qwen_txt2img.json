ties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"widget_ue_connectable":{}},"widgets_values":["ComfyUI"],"widgets_values_named":{"filename_prefix":"ComfyUI"},"color":"#232","bgcolor":"#353"},{"id":194,"type":"LoraLoaderModelOnly","pos":[2370,2530],"size":[330,85],"flags":{},"order":21,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":371},{"localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[372]}],"properties":{"Node name for S&R":"LoraLoaderModelOnly","cnr_id":"comfy-core","ver":"0.39.2","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["Qwen\\Qwen2.1 一致性无偏移_GH_V1.0.safetensors",0.48],"widgets_values_named":{"lora_name":"Qwen\\Qwen2.1 一致性无偏移_GH_V1.0.safetensors","strength_model":0.48}},{"id":195,"type":"GoohaiDisplayAny","pos":[2805,2735],"size":[550,460],"flags":{},"order":25,"mode":0,"inputs":[{"label":"字符串","localized_name":"Any","name":"Any","shape":7,"type":"STRING","link":366}],"outputs":[{"label":"字符串","localized_name":"Any","name":"Any","type":"STRING","links":[367]}],"properties":{"Node name for S&R":"GoohaiDisplayAny","gh_font_size":16,"gh_font_color":"#8693a2","gh_text_style_customized":true,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{}},"aux_id":"goohai/Goohaitools-comfyui","ver":"83abca47fa10d47a1ffd0c7cb62b7fa2a9dc0ddc","gh_display_preview":{"type":"STRING","text":"画面呈现一场暴雨夜中的城市大战，整体为电影级超写实科幻动作场景。左侧占据画面约一半的是奥特曼，他全身可见，呈战斗前倾姿态，双臂向前伸出，掌心相对，似乎在发射或操控一道强烈的白色能量光束。他的身体高大魁梧，肌肉线条明显，皮肤表面为银灰色金属质感，头部和躯干有红色装甲区域，胸部中央有发光的圆形彩色计时器，发出蓝白色光芒。他的面具造型具有明显的怪兽英雄特征，双眼发出明亮的蓝白色光芒，面部表情因头盔设计而显得严肃且具有威胁性。右侧是蝙蝠侠，位于画面右半部分，身穿黑色蝙蝠战衣，头戴尖耳蝙蝠面具，披风在雨中被风吹起，身体向左侧闪避并挥动武器或拳头进行反击。他的服装表面湿透，呈现黑色皮革与哑光织物的混合质感，雨水在披风和装甲上形成反光。两人之间有一道横向的白色能量冲击光束，连接奥特曼的双手与蝙蝠侠的防御姿态，光束周围有电火花、烟雾和破碎的碎片。背景是未来都市的摩天大楼群，高楼林立，窗户透出冷白色和蓝色灯光，部分建筑上有红色警示灯。画面中上方和右侧可见蝙蝠信号投射在建筑物表面，呈现蝙蝠形状的投影，增强了哥谭式黑暗英雄氛围。天空乌云密布，暴雨从画面顶部斜向落下，雨水贯穿整个场景，地面和空气中充满水雾、尘埃和战斗扬起的碎片。整体色调以冷灰、深蓝、黑色为主，奥特曼的红银配色和胸口的蓝白光芒形成强烈对比，蝙蝠侠的黑色装束则融入黑暗城市环境。镜头采用低角度广角构图，强调两位英雄的体型与对抗张力，前景人物巨大化，背景建筑向后延伸，营造出强烈的纵深感和紧迫感。","images":[],"audio":[],"video":[]}},"widgets_values":["STRING"],"widgets_values_named":{"gh_input_type":"STRING"}},{"id":196,"type":"easy ifElse","pos":[3910,2210],"size":[210,80],"flags":{},"order":29,"mode":0,"inputs":[{"label":"真时","localized_name":"真流程","name":"on_true","type":"*","link":372},{"label":"假时","localized_name":"假流程","name":"on_false","type":"*","link":373},{"label":"布尔","localized_name":"是否为真","name":"boolean","type":"BOOLEAN","widget":{"name":"boolean"},"link":369}],"outputs":[{"localized_name":"*","name":"*","type":"*","links":[374]}],"properties":{"Node name for S&R":"easy ifElse","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{}},"cnr_id":"comfyui-easy-use","ver":"130c1b5796d9876a5f853fa0bea88e808cfda4ad"},"widgets_values":[false],"widgets_values_named":{"boolean":false}},{"id":197,"type":"GoohaiAnyExists","pos":[3910,2095],"size":[210,55],"flags":{},"order":28,"mode":0,"inputs":[{"label":"Any","localized_name":"Any","name":"Any","shape":7,"type":"*","link":368}],"outputs":[{"label":"Any","localized_name":"Any","name":"Any","type":"*","links":null},{"localized_name":"布尔","name":"布尔","type":"BOOLEAN","links":[369]}],"properties":{"Node name for S&R":"GoohaiAnyExists","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{}},"aux_id":"goohai/Goohaitools-comfyui","ver":"83abca47fa10d47a1ffd0c7cb62b7fa2a9dc0ddc","gh_input_type":"ANY"},"widgets_values":["ANY"],"widgets_values_named":{"gh_input_type":"ANY"}}],"links":[[18,12,0,16,0,"LATENT"],[19,10,0,16,1,"VAE"],[63,2,0,44,0,"*"],[65,3,0,45,0,"*"],[67,4,0,46,0,"*"],[69,5,0,47,0,"*"],[70,6,0,49,0,"*"],[77,39,1,50,0,"*"],[80,39,2,51,0,"*"],[221,118,0,12,1,"CONDITI