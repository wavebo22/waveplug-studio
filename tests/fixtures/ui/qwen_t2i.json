":105,"fontFamily":"Arial","fontColor":"#FF6347","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":652,"type":"Label (rgthree)","pos":[4407.407041607401,2147.433193969345],"size":[290.9189453125,38],"flags":{"allow_interaction":true},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"▼加速节点(可选)","properties":{"fontSize":38,"fontFamily":"Arial","fontColor":"#FF6347","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":653,"type":"TESpeedQwenImage21","pos":[4377.952341198552,2248.082005651302],"size":[338.1586176451963,228.10520620401257],"flags":{},"order":20,"mode":4,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":921},{"localized_name":"attention","name":"attention","type":"COMBO","widget":{"name":"attention"},"link":null},{"localized_name":"step_cache","name":"step_cache","type":"COMBO","widget":{"name":"step_cache"},"link":null},{"localized_name":"reuse_threshold","name":"reuse_threshold","shape":7,"type":"FLOAT","widget":{"name":"reuse_threshold"},"link":null},{"localized_name":"start_percent","name":"start_percent","shape":7,"type":"FLOAT","widget":{"name":"start_percent"},"link":null},{"localized_name":"end_percent","name":"end_percent","shape":7,"type":"FLOAT","widget":{"name":"end_percent"},"link":null},{"localized_name":"predictor_error_limit","name":"predictor_error_limit","shape":7,"type":"FLOAT","widget":{"name":"predictor_error_limit"},"link":null},{"localized_name":"verbose","name":"verbose","shape":7,"type":"BOOLEAN","widget":{"name":"verbose"},"link":null}],"outputs":[{"localized_name":"model","name":"model","type":"MODEL","links":[915]},{"localized_name":"status","name":"status","type":"STRING","links":[]}],"properties":{"Node name for S&R":"TESpeedQwenImage21","aux_id":"tl2012tl/TE-Speed-QwenImage21","ver":"12a8dd3692d7563865bcfa4fcabff5acf3c8c463"},"widgets_values":["kitchen_int8","te_predictor",0.06,0,0,0.08,true],"widgets_values_named":{"attention":"kitchen_int8","step_cache":"te_predictor","reuse_threshold":0.06,"start_percent":0,"end_percent":0,"predictor_error_limit":0.08,"verbose":true},"color":"#233","bgcolor":"#355"},{"id":654,"type":"Note","pos":[3638.5367789838647,2059.812936617296],"size":[648.2802039458556,605.5395235728638],"flags":{},"order":12,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["◆生成这个角色的三视图，包含正面，侧面，背面，灰色背景\n◆生成这个角色的四视图，从左到右分别为：面部特写，全身正面，全身侧面，全身背面，灰色背景\n\n◆提取图中完整人物，仅保留人物，去除背景，透明背景\n\n◆对这张老照片进行完整修复与上色：彻底去除画面中所有划痕、缺损、污渍与霉点，将模糊的面部五官、衣物与背景重建为清晰锐利的高清细节，恢复自然的皮肤纹理、皱纹层次、头发丝与布料质感；随后为整张照片上自然真实的色彩，还原为干净通透的彩色人像，肤色红润真实、衣物呈现可信的固有色，整体色彩明亮干净、清晰通透，如同清晰彩色照片；完整保留人物的脸型、五官比例与相对位置、表情与神态、姿态以及衣物的款式结构，保持构图、取景与画面缩放完全不变，人物始终为同一可辨认的本人。\n\n◆对图中的产品进行精修，去除产品所有划痕、缺损、污渍、锈迹与杂质，恢复产品崭新的状态，清晰呈现产品原有的材质与结构细节，精细的光照效果与质感，表面干净。构图保持原图产品摆放与视角不变。\n同时对产品进行抠图，将产品从场景中提取出来，输出仅保留产品，透明背景。保留产品完整主体，边缘干净利落、无残留背景色边或锯齿。\n\n◆参考图二的风格，生成一张电影海报，包含图二和图一两个人物背靠背，主题文字为：新的征程，暗金色书法大字\n\n◆让图一的人物穿上图二的衣服\n\n◆根据图中人物制作九宫格表情包，表情依次为：开心，吐舌，愤怒，悲伤，生气，恐惧，哭泣，微笑，害羞。最终输出包含9个表情的九宫格图片\n\n◆按照图中人物的1/7比例，在写实的风格和环境下，制作一个商业化的全身逼真人物模型。保持人物姿势不变，将人物模型放置在电脑桌上，使用圆形透明亚克力底座，底座上不带任何文字。在电脑屏幕上，展示人物模型的ZBrush建模过程。在电脑屏幕旁边，放置一个印有原画的BANDAI风格玩具包装盒。\n\n◆基于提供的 IP 形象，设计 9 种风格各异的姿势，涵盖站立、坐姿、动态动作（如跳跃、挥手）、静态姿态（如托腮、叉腰）等不同类型，每种姿势需贴合该 IP 的核心特征与性格特质，清晰呈现 IP 在各姿势下的整体形态与细节，最终输出包含9个姿势的九宫格图片。\n\n◆图1的人物手里拿着图2的产品进行展示，专业影棚，光线和色调符合所在场景环境\n\n◆根据图片内容生成漫画故事，九格漫画，文本气泡中带有中文剧情，有特写与大场景切换，分镜之间避免雷同，Q版风格\n\n◆把图2的人物头部和发型替换到图1，肤色，比例，和图1保持一致\n\n◆让图一的人物和图二的人物，拥抱在一起，在城市街道\n\n◆生成四格电影分镜，全程人物形象保持统一：\n第1格：少女单膝跪在粗糙黑岩石上，拉满弓弦，目光锁定远处目标，蓄势待发，神情严肃，风吹长发。\n第2格：松开弓弦，弓身震动，箭矢向前射出，长发猛烈飞扬。\n第3格：特写镜头，发光箭矢带着淡青色光尾破空飞行，背景里少女虚化，箭矢带动态速度模糊。\n第4格：少女望向远方，远处目标迸发出橙色小型爆炸，神情放松平静。\n"],"widgets_values_named":{"text":"◆生成这个角色的三视图，包含正面，侧面，背面，灰色背景\n◆生成这个角色的四视图，从左到右分别为：面部特