osition","customSortAlphabet":"","toggleRestriction":"default"}},{"id":582,"type":"TE_text_display","pos":[7014.9707158297815,2612.716998111538],"size":[425.2232702153551,695.1580747337675],"flags":{},"order":19,"mode":0,"inputs":[{"localized_name":"input_text","name":"input_text","shape":7,"type":"STRING","link":848},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null},{"localized_name":"use_edited_text","name":"use_edited_text","shape":7,"type":"BOOLEAN","widget":{"name":"use_edited_text"},"link":null},{"localized_name":"edited_from_text","name":"edited_from_text","shape":7,"type":"STRING","widget":{"name":"edited_from_text"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":[]}],"properties":{"Node name for S&R":"TE_text_display","aux_id":"tl2012tl/TE_MAN","ver":"1431635e9620c362555ed56ae93178451d805d2f","te_text_display_saved_text":"画面呈现为一幅七夕传统节日主题的中国风海报，整体采用横向长卷式构图，背景是深青灰色的夜空与璀璨星空。画面上方悬挂一轮巨大的满月，呈暖白色与淡金色，表面有细腻的云纹肌理和发光晕圈；月亮右侧及周围散布着大小不一的星辰，包括多处十字星芒点缀。画面中段横跨一座巨大的鹊桥，由无数黑色、灰褐色和棕色的喜鹊紧密排列搭成，鸟身相互交错形成拱形桥面，桥梁从左侧山坡延伸至右侧山坡，成为牛郎织女相会的核心通道。桥上站立着两位古装人物：左侧为牛郎，一位年轻成年男性，肤色较浅，黑发束起并戴冠饰，身着深青色长袍，衣摆飘逸，正面向右侧女子，姿态专注；右侧为织女，一位年轻成年女性，身材纤细，黑发高盘并装饰繁复发簪与流苏，身着粉紫色与淡粉色汉服，袖口宽大，裙摆拖曳在桥边，侧身面向男子，二人隔桥相望，神情温柔静默。远景中可见朦胧的山峦、云雾和古代楼阁剪影，营造出仙境般的中秋夜氛围。整张图色彩以冷色调为主，搭配暖月、鹊群和服饰亮色形成对比，光影柔和，细节丰富，具有浓厚的国风浪漫意境。"},"widgets_values":["画面呈现为一幅七夕传统节日主题的中国风海报，整体采用横向长卷式构图，背景是深青灰色的夜空与璀璨星空。画面上方悬挂一轮巨大的满月，呈暖白色与淡金色，表面有细腻的云纹肌理和发光晕圈；月亮右侧及周围散布着大小不一的星辰，包括多处十字星芒点缀。画面中段横跨一座巨大的鹊桥，由无数黑色、灰褐色和棕色的喜鹊紧密排列搭成，鸟身相互交错形成拱形桥面，桥梁从左侧山坡延伸至右侧山坡，成为牛郎织女相会的核心通道。桥上站立着两位古装人物：左侧为牛郎，一位年轻成年男性，肤色较浅，黑发束起并戴冠饰，身着深青色长袍，衣摆飘逸，正面向右侧女子，姿态专注；右侧为织女，一位年轻成年女性，身材纤细，黑发高盘并装饰繁复发簪与流苏，身着粉紫色与淡粉色汉服，袖口宽大，裙摆拖曳在桥边，侧身面向男子，二人隔桥相望，神情温柔静默。远景中可见朦胧的山峦、云雾和古代楼阁剪影，营造出仙境般的中秋夜氛围。整张图色彩以冷色调为主，搭配暖月、鹊群和服饰亮色形成对比，光影柔和，细节丰富，具有浓厚的国风浪漫意境。",false,""],"widgets_values_named":{"text":"画面呈现为一幅七夕传统节日主题的中国风海报，整体采用横向长卷式构图，背景是深青灰色的夜空与璀璨星空。画面上方悬挂一轮巨大的满月，呈暖白色与淡金色，表面有细腻的云纹肌理和发光晕圈；月亮右侧及周围散布着大小不一的星辰，包括多处十字星芒点缀。画面中段横跨一座巨大的鹊桥，由无数黑色、灰褐色和棕色的喜鹊紧密